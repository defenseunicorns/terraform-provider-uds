{
  "enabled": true,
  "forkProcessing": "enabled",
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>defenseunicorns/uds-common//config/renovate.json5",
    "config:recommended"
  ],
  "branchConcurrentLimit": 0,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignorePaths": [],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "rebaseWhen": "conflicted",
  "commitBodyTable": true,
  "suppressNotifications": ["prIgnoreNotification"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchFileNames": [".github/**"],
      "groupName": "github-actions",
      "commitMessageTopic": "github actions"
    },
    {
      "matchFileNames": ["go.mod", "go.sum"],
      "groupName": "go-dependencies",
      "commitMessageTopic": "go dependencies"
    },
    {
      "matchPackageNames": ["zarf-dev/zarf", "github.com/zarf-dev/zarf"],
      "groupName": "zarf",
      "commitMessageTopic": "zarf"
    },
    {
      "matchPackageNames": ["zarf-dev/zarf"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["test/acc/package_test.go"],
      "allowedVersions": "<=0.76.0",
      "description": "Pinned temporarily at v0.76.0; v0.77.0+ init packages are signed with keyless method which is not yet supported. See Linear CLI-200"
    },
    {
      "matchFileNames": ["**/*.tf", "**/*.tfvars", "**/*.hcl"],
      "matchManagers": ["terraform"],
      "groupName": "terraform-dependencies",
      "commitMessageTopic": "terraform dependencies"
    },
    {
      "matchFileNames": ["README.md"],
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "readme-versions",
      "commitMessageTopic": "readme versions"
    },
    {
      "matchPackageNames": ["defenseunicorns/terraform-provider-uds"],
      "matchManagers": ["custom.regex"],
      "ignoreUnstable": true,
      "groupName": "uds-provider-version",
      "commitMessageTopic": "uds provider version"
    },
    {
      "matchFileNames": ["package.json", "package-lock.json"],
      "groupName": "dev-dependencies",
      "matchDepTypes": ["devDependencies"],
      "commitMessageTopic": "dev dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"\\s*#\\s*UDS\\s+Provider\\s+Version"],
      "depNameTemplate": "defenseunicorns/terraform-provider-uds",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": ["zarf-dev/packages/init:v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*#\\s*renovate:\\s*datasource=github-tags\\s+depName=zarf-dev/zarf"],
      "depNameTemplate": "zarf-dev/zarf",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["<!--\\s*renovate:\\s*datasource=github-tags\\s+depName=zarf-dev/zarf[^>]*-->\\s*```[\\s\\S]*?zarf-dev/packages/init:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "zarf-dev/zarf",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.go$/"],
      "matchStrings": ["//\\s*renovate:\\s*datasource=github-tags\\s+depName=zarf-dev/zarf\\s*\\nconst\\s+\\w+\\s*=\\s*\"v(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "zarf-dev/zarf",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": ["source\\s*=\\s*\"defenseunicorns/uds\"\\s*\\n\\s*version\\s*=\\s*\"~>\\s*(?<currentValue>\\d+\\.\\d+)\\.\\d+\"\\s*#\\s*renovate:\\s*datasource=github-releases\\s+depName=defenseunicorns/terraform-provider-uds"],
      "depNameTemplate": "defenseunicorns/terraform-provider-uds",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["<!--\\s*renovate:\\s*datasource=github-releases\\s+depName=defenseunicorns/terraform-provider-uds[^>]*-->\\s*```[\\s\\S]*?version\\s*=\\s*\"~>\\s*(?<currentValue>\\d+\\.\\d+)\\.\\d+\""],
      "depNameTemplate": "defenseunicorns/terraform-provider-uds",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
