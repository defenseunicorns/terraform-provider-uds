{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>defenseunicorns/uds-common//config/renovate.json5"
  ],
  "branchConcurrentLimit": 0,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "separateMajorMinor": false,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchDatasources": ["terraform-provider"],
      "matchPackageNames": ["defenseunicorns/uds"],
      "enabled": false
    },
    {
      "matchFileNames": ["go.mod", "go.sum"],
      "groupName": "application-deps",
      "commitMessageTopic": "application dependencies"
    },
    {
      "matchFileNames": [
        ".github/**",
        ".vscode/**",
        "README.md",
        "examples/**",
        "release-please-config.json",
        "renovate.json",
        "tasks.yaml",
        "test/**"
      ],
      "groupName": "support-deps",
      "commitMessageTopic": "support dependencies"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "support-deps",
      "commitMessageTopic": "support dependencies"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "groupName": "application-deps",
      "commitMessageTopic": "application dependencies"
    },
    {
      "matchPackageNames": ["zarf-dev/zarf", "github.com/zarf-dev/zarf", "ghcr.io/zarf-dev/**"],
      "groupName": "zarf",
      "commitMessageTopic": "zarf"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Extends the uds-common bundle OCI package matcher to source assignments in this repository's Go, HCL, JSON, Markdown, shell, Terraform, and YAML files: https://github.com/defenseunicorns/uds-common/blob/1b0c23314df0fbc002e0ad28ac1debf40e43002f/config/renovate.json5#L141-L153",
      "fileMatch": [".*(\\.go|\\.hcl|\\.json|\\.md|\\.sh|\\.tf|\\.ya?ml)$"],
      "matchStrings": ["(?m)^\\s*source\\s*=\\s*\"(?:oci:\\/\\/)?(?<depName>[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)+):(?<currentValue>[A-Za-z0-9_][A-Za-z0-9._-]*)\"\\s*$"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
