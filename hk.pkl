amends "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["check-added-large-files"] {
        check = "hk util check-added-large-files --maxkb=1024 {{files}}"
        glob = List("**/*")
        exclude = List("build/**")
    }
    ["check-merge-conflict"] {
        check = "hk util check-merge-conflict {{files}}"
        glob = List("**/*")
        exclude = List("build/**")
    }
    ["detect-private-key"] {
        check = "hk util detect-private-key {{files}}"
        glob = List("**/*")
        exclude = List("build/**")
    }
    ["end-of-file-fixer"] = (Builtins.newlines) {
        exclude = List("*.json", "build/**")
    }
    ["fix-byte-order-marker"] = (Builtins.byte_order_marker) {
        exclude = List("build/**")
    }
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = List("build/**", "docs/index.md")
    }
    ["golangci-lint"] {
        check = "golangci-lint run ./..."
        glob = List("**/*.go", "go.mod", "go.sum")
    }
    ["generated-docs"] {
        check = """
            generated_docs_tmp="$(mktemp -d)"
            trap 'rm -rf "$generated_docs_tmp"' EXIT
            cp -R docs examples "$generated_docs_tmp"

            if ! go generate ./...; then
                echo "Documentation generation failed. Run 'uds run generate' for the full output." >&2
                exit 1
            fi

            generated_docs_changed=0
            diff -ru "$generated_docs_tmp/docs" docs || generated_docs_changed=1
            diff -ru "$generated_docs_tmp/examples" examples || generated_docs_changed=1

            if [ "$generated_docs_changed" -ne 0 ]; then
                echo "Generated documentation is out of date. Run 'uds run generate' and commit the results." >&2
                exit 1
            fi
            """
        glob = List("**/*.go", "go.mod", "go.sum", "templates/**/*.tmpl", "docs/**/*.md", "examples/**/*.tf", "examples/**/*.sh")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...linters
        }
    }
    ["check"] {
        steps {
            ...linters
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...linters
        }
    }
}
